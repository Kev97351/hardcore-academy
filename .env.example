# ═══════════════════════════════════════════════════
#  HardCore Academy — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════

# Stripe (tableau de bord → Developers → API Keys)
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX

# URL de ton site (ex: https://hardcore-academy.vercel.app)
SITE_URL=https://ton-site.vercel.app

# Clé secrète admin (invente une chaîne aléatoire longue)
ADMIN_KEY=change_moi_avec_une_cle_tres_longue_et_aleatoire_123456

# Port local (optionnel)
PORT=3000
